VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Calendar sync — VITE_GOOGLE_CLIENT_ID is safe to expose (OAuth client
# IDs are public by design); GOOGLE_CLIENT_SECRET is server-only, read by
# api/google-oauth-exchange.ts and api/google-oauth-refresh.ts (never bundled
# into client code, never prefixed with VITE_). Redirect URI to register in
# Google Cloud Console: <origin>/oauth/google/callback (e.g.
# http://localhost:5173/oauth/google/callback for local dev).
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
