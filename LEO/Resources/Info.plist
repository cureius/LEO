<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.theblueman.leo.refresh</string>
		<string>com.theblueman.leo.processing</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>LEO</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>LEO</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCalendarsUsageDescription</key>
	<string>LEO syncs with your iOS calendars to show everything in one place.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>LEO creates events in your iOS calendars.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>LEO uses your location for location-based reminders even when the app is in the background.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>LEO uses your location for location-based reminders.</string>
	<key>NSCameraUsageDescription</key>
	<string>LEO uses the camera so you can photograph handwritten notes and convert them to tasks and events.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>LEO uses the microphone for voice quick-add.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>LEO reads photos so you can convert handwritten notes into tasks and events.</string>
	<key>NSRemindersUsageDescription</key>
	<string>LEO syncs with your reminders to show everything in one place.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>LEO uses speech recognition to convert your voice to captured items.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>LEO does not track you. This entry is required by iOS.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>processing</string>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Background</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
